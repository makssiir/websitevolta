{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && npm run verify",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self'; font-src 'self'; connect-src 'self'; frame-src https://www.google.com; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/en/business",
      "destination": "/zakelijk",
      "statusCode": 302
    },
    {
      "source": "/en/services",
      "destination": "/diensten",
      "statusCode": 302
    },
    {
      "source": "/en/services/:path*",
      "destination": "/diensten",
      "statusCode": 302
    },
    {
      "source": "/en/about",
      "destination": "/over-ons",
      "statusCode": 302
    },
    {
      "source": "/en/contact",
      "destination": "/contact",
      "statusCode": 302
    },
    {
      "source": "/en/privacy",
      "destination": "/privacy",
      "statusCode": 302
    },
    {
      "source": "/en",
      "destination": "/",
      "statusCode": 302
    },
    {
      "source": "/en/:path*",
      "destination": "/",
      "statusCode": 302
    },
    {
      "source": "/uk/business",
      "destination": "/zakelijk",
      "statusCode": 302
    },
    {
